graph TD
    classDef observe fill:#eef2ff,stroke:#6366f1,stroke-width:2px,color:#312e81
    classDef propose fill:#fdf4ff,stroke:#c026d3,stroke-width:2px,color:#701a75
    classDef validate fill:#f0fdf4,stroke:#22c55e,stroke-width:2px,color:#14532d
    classDef act fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#7c2d12
    
    A[Observe State]:::observe --> B[Ground Targets]:::observe
    B --> C[Model Proposes Action]:::propose
    C --> D{Validate Policy}:::validate
    D -- Denied --> E[Reject / Request Input]:::validate
    D -- Approved --> F[Act on UI]:::act
    F --> G[Verify Postcondition]:::validate
    G -- Failed --> H[Recover / Retry]:::propose
    G -- Success --> A
    H --> A
